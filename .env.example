# Application
APP_URL=http://localhost:3000
SESSION_SECRET=replace_with_a_secure_random_secret

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Redis
REDIS_USERNAME=default
REDIS_PASSWORD=replace_with_redis_password
REDIS_HOST=your-redis-host
REDIS_PORT=6379

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_verified_sender_email

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_WHATSAPP_FROM=your_whatsapp_sender
TWILIO_OTP_CONTENT_SID=your_whatsapp_template_sid
TWILIO_WEBHOOK_URL=your_webhook_url

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret